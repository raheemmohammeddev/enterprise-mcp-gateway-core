# ============================================================
# Enterprise MCP Gateway - Environment Configuration
# Copy to .env and fill in values for local development.
# ============================================================

# -- Server --
MCP_SERVER_PORT=8100
LOG_LEVEL=INFO

# -- DocumentDB (MongoDB-compatible) --
DOCDB_HOST=localhost
DOCDB_PORT=27017
DOCDB_USERNAME=admin
DOCDB_PASSWORD=changeme
DOCDB_DATABASE=ENTERPRISE_MCP_GATEWAY
# Secure default: TLS with full certificate validation. The DocumentDB/RDS CA
# bundle must be in the host trust store. Set to false only for a local
# plaintext MongoDB container.
DOCDB_TLS_ENABLED=true

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false
REDIS_ENABLED=true

# -- JWT Authentication --
JWT_AUTH_ENABLED=false
JWT_SECRET=replace-with-a-strong-secret
# One key family only (HMAC, RSA or EC). A mixed list is refused at validation
# time because it enables algorithm-confusion attacks.
JWT_ALGORITHMS=HS512
# Audience verification is on by default; JWT_AUDIENCE must then be non-empty.
JWT_VERIFY_AUD=true
JWT_AUDIENCE=
# Required when JWT_AUTH_ENABLED=true; validation is refused if empty.
JWT_ISSUER=
JWT_CLAIM_USER_ID=sAMAccountName,sub
JWT_CLAIM_USERNAME=preferred_username,name
JWT_CLAIM_EMAIL=email
JWT_CLAIM_GROUPS=groups,roles
JWT_REQUIRED_CONSUMER_TYPES=ai-agent

# -- Kiro RBAC --
# Secure default: IDE consumers must present a gateway-signed token.
KIRO_RBAC_ENABLED=true
# Local-development escape hatch for the legacy auto-whitelist. Even when
# true it also requires KIRO_RBAC_ENABLED=false and a loopback client address.
GATEWAY_ALLOW_INSECURE_LOCAL=false
# Grant a local stdio caller (no AuthMiddleware, therefore no identity)
# unrestricted tool and project scope. Must stay false for any HTTP deployment.
GATEWAY_STDIO_TRUST_LOCAL=false
KIRO_TOKEN_TTL_HOURS=24
KIRO_TOKEN_ISSUER=enterprise-mcp-gateway
KIRO_TOKEN_AUDIENCE=kiro-mcp

# -- Rate Limiting --
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JIRA=30
RATE_LIMIT_BRE=5
RATE_LIMIT_NEO4J=200
RATE_LIMIT_TERADATA=20
RATE_LIMIT_DEFAULT=59

# -- Caching --
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# -- Write Authorization --
USER_WRITE_AUTH_ENABLED=true
WRITE_AD_GROUPS=Platform-Admin,Platform-Write-Dev

# -- Feature Flags --
NEO4J_ENABLED=true
TERADATA_MCP_ENABLED=true

# -- Neo4j --
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# -- Teradata MCP Sidecar --
TERADATA_MCP_URL=http://localhost:8001/mcp
TERADATA_MCP_TIMEOUT_SECONDS=30

# -- Jira --
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=
JIRA_BACKEND=pat

# -- AWS KMS Encryption --
ENCRYPTION_ENABLED=false
KMS_KEY_ID=alias/enterprise-mcp-gateway-tokens
AWS_REGION=us-east-1
